{
  "name": "scenarigo",
  "displayName": "Scenarigo",
  "description": "Language support for scenarigo scenario and configuration files, through the scenarigo language server.",
  "version": "0.0.1",
  "private": true,
  "publisher": "scenarigo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenarigo/scenarigo",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Scenarigo",
      "properties": {
        "scenarigo.path": {
          "type": "string",
          "default": "scenarigo",
          "scope": "machine-overridable",
          "markdownDescription": "Path of the `scenarigo` binary. The extension starts `scenarigo lsp` with it. The language server stays silent on YAML files without a `schemaVersion` key."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "scenarigo.template.injection",
        "path": "./syntaxes/scenarigo-template.injection.json",
        "injectTo": [
          "source.yaml"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test:grammar": "node test/grammar.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.82.0",
    "typescript": "~5.6.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
